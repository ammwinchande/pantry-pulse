# ============================================================
# PantryPulse Backend — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================

# --- Application ---
ENVIRONMENT=development
# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Base URL of the frontend (used to build email activation/reset links)
APP_BASE_URL=http://localhost:5173
# Port for uvicorn
PORT=8000

# --- Logging ---
# Verbosity for console + file logs: DEBUG | INFO | WARNING | ERROR
#   DEBUG  — verbose (includes per-request detail, DB schema checks, pickup codes)
#   INFO   — recommended default (business events, request lines, seed summary)
#   WARNING/ERROR — quiet (only problems)
LOG_LEVEL=INFO
# Optional path to a rotating log file (5 MB x 3 backups). Leave empty for
# console-only. In production (App Runner) set e.g. /app/logs/pantrypulse.log
LOG_FILE=

# --- Persistence (datastore) ---
# SQLAlchemy URL. SQLite by default (zero-config, file created next to the
# backend). To switch datastores in production, set this to Postgres or MySQL
# — no application code changes required:
#   PostgreSQL: postgresql+psycopg://user:pass@host:5432/pantrypulse
#   MySQL:      mysql+pymysql://user:pass@host:3306/pantrypulse
DATABASE_URL=sqlite:///pantrypulse.db
# Load demo/seed data on boot (idempotent). Set false in production.
SEED_ON_STARTUP=true

# --- JWT / Auth ---
# REQUIRED in production: use a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-secret-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=120
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Demo aid: include activation/reset URLs in API responses (dev only)
EXPOSE_DEV_TOKENS=true

# --- Mailtrap.io (transactional email: registration activation,
#     password reset, password change notifications) ---
# Create a sandbox at https://mailtrap.io and copy its API key
MAILTRAP_API_KEY=
MAILTRAP_SENDER_EMAIL=pantrypulse@sandbox.mailtrap.io
MAILTRAP_SENDER_NAME=PantryPulse

# SMTP credentials for your Mailtrap sandbox (or any SMTP provider).
# NOTE: these are secrets — put your real values in `.env`, never in this file.
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-smtp-username
MAIL_PASSWORD=your-mailtrap-smtp-password
